---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" robots="noindex" canonical={false}>
  <article class="post-container post-container--single">
    <header class="post-header">
      <h1 class="post-title">Page Not Found</h1>
    </header>

    <section class="post">
      <p>Sorry, the page you're looking for doesn't exist or has moved.</p>
      <p><a href="/">Head back to the home page</a></p>
    </section>
  </article>
</BaseLayout>
