---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GoogleDrivePlayer from '../../components/GoogleDrivePlayer.astro';
import PostMeta from '../../components/PostMeta.astro';
import RecipeIcon from '../../components/RecipeIcon.astro';
import { getPosts, postExcerpt, postSlug, postYear, renderMarkdown, stripHtml, type Post } from '../../site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { year: postYear(post), slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Post };
const { title, date, tags, recipe, videos } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={stripHtml(postExcerpt(post))} videos={videos}>
  <article class="post-container post-container--single" itemscope={recipe ? true : undefined} itemtype={recipe ? 'http://schema.org/Recipe' : undefined}>
    <header class="post-header">
      <div class="post-meta">
        <PostMeta date={date} tags={tags} class="post-meta__date" />
      </div>
      <h1 class="post-title">{title}</h1>
    </header>

    <section class="post">
      {
        recipe && (
          <div class="featured-image">
            <img itemprop="photo" src={`/images/recipes/${recipe.image}`} alt={title} />
            {recipe.imagecredit && (
              <a href={recipe.imagecredit} title="Image credit">
                <svg class="geomicon" width="14" height="14" viewBox="0 0 32 32" style="fill:currentcolor">
                  <title>camera icon</title>
                  <path d="M0 6 L8 6 L10 2 L22 2 L24 6 L32 6 L32 28 L0 28 z M9 17 A7 7 0 0 0 23 17 A7 7 0 0 0 9 17" />
                </svg>
              </a>
            )}
          </div>
        )
      }

      <Content components={{ GoogleDrivePlayer }} />

      {
        recipe && (
          <>
            <ul id="recipe" class="recipe-overview">
              <li title="Servings">
                <RecipeIcon icon="quantity" />
                <span>{recipe.servings}</span>
              </li>
              <li title="Prep Time">
                <RecipeIcon icon="time" />
                <span>{recipe.prep}</span>
              </li>
              <li title="Cook Time">
                <RecipeIcon icon="cook" />
                <span>{recipe.cook}</span>
              </li>
            </ul>

            <div class="recipe-contents">
              <div class="ingredients">
                <h2>Ingredients</h2>
                <Fragment set:html={renderMarkdown(recipe.ingredients)} />
              </div>

              <div class="directions">
                <h2>Directions</h2>
                <Fragment set:html={renderMarkdown(recipe.directions)} />
              </div>
            </div>
          </>
        )
      }
    </section>
  </article>
</BaseLayout>
