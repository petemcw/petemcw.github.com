---
import BaseLayout from '../layouts/BaseLayout.astro';
import TaxonomyIndex from '../components/TaxonomyIndex.astro';
import { getPosts, groupPosts } from '../site';

const groups = groupPosts(await getPosts(), (post) => post.data.tags);
---

<BaseLayout title="Tags" robots="noindex">
  <TaxonomyIndex heading="Tags" className="tags" groups={groups} />
</BaseLayout>
